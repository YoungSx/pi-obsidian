{
	"name": "piem",
	"version": "0.1.0-alpha.9",
	"description": "Run the Piem agent inside Obsidian with vault-scoped tools and a chat side panel.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "bun test",
		"lint": "eslint .",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:copy": "node scripts/check-copy.mjs",
		"verify": "npm run build && npm run check:bundle && npm run check:copy && bun test && npm run lint"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/bun": "^1.3.11",
		"@types/node": "^22.19.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"electron": "^44.0.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"happy-dom": "^20.11.6",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.3",
		"@earendil-works/pi-ai": "^0.84.3",
		"@modelcontextprotocol/client": "^2.0.0",
		"obsidian": "latest",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"typebox": "^1.1.37",
		"yaml": "2.9.0"
	}
}
